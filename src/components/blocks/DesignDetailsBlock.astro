---
import { type PageBlocksMap, type DesignPageModel } from '../../lib/models'
import { optimizeImage } from '../../lib/images'
import Container from '../elements/Container.astro'
import DecoratorImage from '../elements/DecoratorImage.astro'
import Heading from '../elements/Heading.astro'
import Text from '../elements/Text.astro'
import SymbolImage from '../elements/SymbolImage.astro'
import OptimizedImage from '../elements/OptimizedImage.astro'
import Markdown from '../elements/Markdown.astro'
import DesignThumbnail from '../elements/DesignThumbnail.astro'
import CloseIcon from '../elements/CloseIcon.astro'
import '../../styles/design-details.css'

interface Props {
  block: PageBlocksMap['design_details_block']
  page: DesignPageModel
}

const { block, page } = Astro.props
const { data: design, body } = page.getItem().entry
const images = [design.featuredImage, ...design.additionalImages.map((item) => item.image)]
const enlargedImages = await Promise.all(images.map((image) => optimizeImage(image, { maxWidth: 2000 })))
const additionalIndices = design.additionalImages.map((_, index) => index + 1)
const firstRow = additionalIndices.length ? additionalIndices : [0]
const secondRow = additionalIndices.length > 4 ? additionalIndices.slice(4) : firstRow
const pageCount = Math.ceil(secondRow.length / 4)
const secondPages = Array.from({ length: pageCount }, (_, page) => {
  const start = Math.min(page * 4, Math.max(0, secondRow.length - 4))
  return Array.from({ length: 4 }, (_, slot) => secondRow[(start + slot) % secondRow.length]!)
})
---

<Container variant="xl" aria-label="Design Details" class="design-gallery text-base-900">
  <div class="design-header">
    <div class="design-main">
      <DecoratorImage class="bg-base-900 self-end" />
      <div class="content-frame design-main-frame">
        {
          design.badge && (
            <div class="absolute top-2 left-2 z-40 bg-base-100 border-2 border-base-900 px-4 flex gap-2">
              <Text variant={'lg'} class="text-base-900">
                {design.badge}
              </Text>
              <SymbolImage class="bg-base-900" />
            </div>
          )
        }
        {
          images.map((image, index) => (
            <button
              type="button"
              class="design-slide"
              data-slide={index}
              data-full-src={enlargedImages[index]?.src}
              aria-label={`Enlarge ${design.title}, image ${index + 1}`}
              hidden={index !== 0}
            >
              <OptimizedImage
                src={image}
                alt={`${design.title}, image ${index + 1}`}
                loading={index === 0 ? 'eager' : 'lazy'}
                sizes="(min-width: 1440px) 40vw, (min-width: 768px) 50vw, 100vw"
                class="w-full h-full object-cover"
              />
              <span class="design-image-status" role="status" hidden />
            </button>
          ))
        }
        {
          images.length > 1 && (
            <>
              <button type="button" class="design-arrow design-prev" data-main-step="-1" aria-label="Previous image">
                ‹
              </button>
              <button type="button" class="design-arrow design-next" data-main-step="1" aria-label="Next image">
                ›
              </button>
            </>
          )
        }
      </div>
      <p class="design-counter" data-main-counter aria-live="polite" aria-atomic="true">1 / {images.length}</p>
    </div>
    <div class="design-summary">
      <div class="w-full">
        <Heading tagName={block.size ?? 'h1'} tagSize={block.size ?? 'h1'} class="design-title">
          {design.title}
        </Heading>
        {design.subtitle && <Text variant={'md'}>{design.subtitle}</Text>}
      </div>
      <Markdown variant="lg" content={design.description} />
    </div>
  </div>
  <div class="design-thumbnails" aria-label="Project images">
    {
      Array.from({ length: 4 }, (_, slot) => firstRow[slot % firstRow.length]!).map((index) => (
        <DesignThumbnail image={images[index]!} title={design.title} imageIndex={index} />
      ))
    }
  </div>
  <article class="md:max-w-3xl mx-auto w-full flex flex-col items-start gap-7">
    <Markdown variant="sm" content={body} />
    {
      design.paypalProductId && (
        <div class="design-order w-full font-mono">
          <Markdown variant="md" content={block.orderFormLabel} />
          <paypal-add-to-cart-button data-id={design.paypalProductId} />
        </div>
      )
    }
  </article>
  <div class="design-lower" aria-label="More project images">
    {
      secondPages.map((indices, page) => (
        <div class="design-thumbnails" data-thumbnail-page={page} hidden={page !== 0}>
          {indices.map((index) => (
            <DesignThumbnail image={images[index]!} title={design.title} imageIndex={index} />
          ))}
        </div>
      ))
    }
    {
      pageCount > 1 && (
        <div class="design-controls">
          <button type="button" data-page-step="-1" aria-label="Previous group of images">
            ‹
          </button>
          <p class="design-counter" data-page-counter aria-live="polite" aria-atomic="true">
            1 / {pageCount}
          </p>
          <button type="button" data-page-step="1" aria-label="Next group of images">
            ›
          </button>
        </div>
      )
    }
  </div>
  <dialog class="design-dialog overlay-surface" aria-label={`${design.title} image gallery`}>
    <button type="button" class="design-close overlay-close" aria-label="Close image gallery" autofocus>
      <CloseIcon />
    </button>
    <div class="design-enlarged">
      <img class="content-frame design-enlarged-image" alt="" />
      <p class="design-image-status" role="status" hidden></p>
      {
        images.length > 1 && (
          <>
            <button type="button" class="design-arrow design-prev" data-main-step="-1" aria-label="Previous image">
              ‹
            </button>
            <button type="button" class="design-arrow design-next" data-main-step="1" aria-label="Next image">
              ›
            </button>
          </>
        )
      }
    </div>
    <p class="design-counter" data-modal-counter aria-live="polite" aria-atomic="true">1 / {images.length}</p>
  </dialog>
</Container>

<script>
  import '../../scripts/design-gallery'
</script>

<script is:inline define:vars={{ paypalProductId: design.paypalProductId }}>
  if (paypalProductId) {
    cartPaypal.AddToCart({ id: paypalProductId })
  }
</script>
