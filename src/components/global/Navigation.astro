---
// components
import Link from '../elements/Link.astro'
import CloseIcon from '../elements/CloseIcon.astro'
import MenuIcon from '../elements/MenuIcon.astro'
import { getSettings } from '../../lib/content'
import { optimizeImage } from '../../lib/images'

const { layout, navigation } = await getSettings()
const logo = await optimizeImage(navigation.logoImage, { maxWidth: 480 })
---

<nav class="flex justify-end py-8 fixed top-0 right-6 left-0 z-50 md:right-0 md:p-0">
  <!-- Desktop Nav -->
  <div class="desktop-nav hidden md:flex! h-22 w-full items-center justify-between gap-8 bg-base-900 px-8">
    <a href="/" class="min-w-0 shrink-0 font-sans text-24" aria-label={layout.mainPageTitle}>
      {
        logo ? (
          <img
            src={logo.src}
            width={logo.width}
            height={logo.height}
            alt={layout.mainPageTitle ?? ''}
            class="h-16 w-auto max-w-60 object-contain"
          />
        ) : (
          layout.mainPageTitle
        )
      }
    </a>
    <ul class="flex items-center gap-8">
      {
        navigation.navigationLinks.map((link) => (
          <li>
            <Link href={link.href ?? '#'} variant={'nav'} class="whitespace-nowrap">
              {link.title}
            </Link>
          </li>
        ))
      }
      <paypal-cart-button data-id="pp-view-cart"></paypal-cart-button>
      <script is:inline>
        cartPaypal.Cart({ id: 'pp-view-cart' })
      </script>
    </ul>
  </div>
  <!-- Mobile Nav -->
  <div class="md:hidden">
    <button
      id="open-nav"
      aria-label="Open Navigation"
      class="fixed top-8 right-6 flex size-10 items-center justify-center text-base-900"
    >
      <MenuIcon />
    </button>
    <div class="overlay-surface hidden fixed inset-0 z-50" id="mobile-nav">
      <div class="flex flex-col items-center justify-center h-full">
        <button id="close-nav" aria-label="Close Navigation" class="overlay-close">
          <CloseIcon />
        </button>
        <ul class="flex flex-col p-6 gap-5 md:hidden text-center">
          {
            navigation.navigationLinks.map((link) => (
              <li>
                <Link href={link.href ?? '#'} variant={'nav'}>
                  {link.title}
                </Link>
              </li>
            ))
          }
          <li class="flex justify-center">
            <paypal-cart-button data-id="pp-view-cart-mobile"></paypal-cart-button>
            <script is:inline>
              cartPaypal.Cart({ id: 'pp-view-cart-mobile' })
            </script>
          </li>
        </ul>
      </div>
    </div>
  </div>
</nav>

<script>
  const mobileNav = document.querySelector('#mobile-nav') as HTMLUListElement
  const openBtn = document.querySelector('#open-nav') as HTMLButtonElement
  const closeBtn = document.querySelector('#close-nav') as HTMLButtonElement

  if (mobileNav && openBtn && closeBtn) {
    openBtn.addEventListener('click', () => {
      mobileNav.classList.remove('hidden')
      openBtn.classList.add('hidden')
    })
    closeBtn.addEventListener('click', () => {
      mobileNav.classList.add('hidden')
      openBtn.classList.remove('hidden')
    })
  }
</script>
