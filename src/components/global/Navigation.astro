---
// components
import Link from '../elements/Link.astro'
import { getSettings } from '../../lib/content'

const { navigation } = await getSettings()
---

<nav class="flex justify-end py-8 fixed top-0 right-6 left-0 z-50">
  <!-- Desktop Nav -->
  <ul class="hidden md:flex gap-8">
    {
      navigation.navigationLinks.map((link, index) => (
        <li>
          <Link href={link.href ?? '#'} variant={'nav'}>
            {index + 1}. {link.title}
          </Link>
        </li>
      ))
    }
  </ul>
  <!-- Mobile Nav -->
  <div class="md:hidden">
    <button
      id="open-nav"
      aria-label="Open Navigation"
      class="fixed top-8 right-6 flex size-10 items-center justify-center text-base-900"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M7 8h10M7 12h10M7 16h10"></path>
      </svg>
    </button>
    <div class="hidden fixed inset-0 bg-base-100 z-50" id="mobile-nav">
      <div class="flex flex-col items-center justify-center h-full">
        <button
          id="close-nav"
          aria-label="Close Navigation"
          class="fixed top-8 right-6 flex size-10 items-center justify-center text-base-900"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="40"
            height="40"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M8 8 16 16M8 16 16 8"></path>
          </svg>
        </button>
        <ul class="flex flex-col p-6 gap-5 md:hidden text-center">
          {
            navigation.navigationLinks.map((link) => (
              <li>
                <Link href={link.href ?? '#'} variant={'nav'}>
                  {link.title}
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</nav>

<script>
  const mobileNav = document.querySelector('#mobile-nav') as HTMLUListElement
  const openBtn = document.querySelector('#open-nav') as HTMLButtonElement
  const closeBtn = document.querySelector('#close-nav') as HTMLButtonElement

  if (mobileNav && openBtn && closeBtn) {
    openBtn.addEventListener('click', () => {
      mobileNav.classList.remove('hidden')
      openBtn.classList.add('hidden')
    })
    closeBtn.addEventListener('click', () => {
      mobileNav.classList.add('hidden')
      openBtn.classList.remove('hidden')
    })
  }
</script>
