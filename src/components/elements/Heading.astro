---
import type { HTMLAttributes } from 'astro/types'

const headingOptions = {
  h1: 'text-[length:var(--heading-h1-size)]',
  h2: 'text-[length:var(--heading-h2-size)]',
  h3: 'text-[length:var(--heading-h3-size)]',
  h4: 'text-[length:var(--heading-h4-size)]',
  h5: 'text-[length:var(--heading-h5-size)]',
  h6: 'text-[length:var(--heading-h6-size)]',
}

interface Props extends HTMLAttributes<'h1'> {
  tagName: keyof typeof headingOptions
  tagSize: keyof typeof headingOptions
}

const { tagName, tagSize, class: className, ...rest } = Astro.props
const Tag = tagName

// common style for all headings
const baseStyle = 'font-sans uppercase text-base-900 tracking-tight leading-none'
---

<Tag class:list={[baseStyle, headingOptions[tagSize], className]} {...rest}><slot /></Tag>
