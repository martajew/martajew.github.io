---
import type { ImageMetadata } from 'astro'
import OptimizedImage from './OptimizedImage.astro'

interface Props {
  image: ImageMetadata
  title: string | undefined
  imageIndex: number
}

const { image, title, imageIndex } = Astro.props
---

<button
  type="button"
  class="design-frame design-thumbnail"
  data-image-index={imageIndex}
  aria-label={`Enlarge ${title}, image ${imageIndex + 1}`}
>
  <OptimizedImage
    src={image}
    alt={`${title}, image ${imageIndex + 1}`}
    loading="lazy"
    widths={[200, 400].filter((width) => width <= image.width)}
    sizes="(min-width: 768px) 25vw, 50vw"
    class="design-thumbnail-image object-cover"
  />
</button>
